# Never send secrets, local state, or build clutter to the Docker daemon.
.git/
.env
.env.*
.pytest_cache/
tests/
.venv/
data/
audio/
voices.json
__pycache__/
*.py[oc]
.python-version
.ruff_cache/

# Docs and repo metadata not needed inside the image
assets/
renovate.json
docker-compose.yml
Dockerfile
.dockerignore

# Generated audio lives under data/ and audio/ — scope the patterns there so
# the bundled emote sound files (emotes/*.mp3) still reach the build context.
data/**/*.wav
data/**/*.mp3
audio/**/*.wav
audio/**/*.mp3

# emotes.db is generated locally by voxer/fetch_emotes.py (it is gitignored);
# only the bundled sound files are baked into the image.
emotes/emotes.db

# Public-image allowlist: clips without supplied redistribution rights must
# never enter a context/image layer. Private custom mounts remain supported.
voxer/sounds/*.mp3
!voxer/sounds/pop.mp3
!voxer/sounds/zap.mp3
!voxer/sounds/sparkle.mp3
!voxer/sounds/ding.mp3
!voxer/sounds/crunch.mp3
!voxer/sounds/chirp.mp3
!voxer/sounds/choo-choo.mp3
!voxer/sounds/splash.mp3
!voxer/sounds/tweet.mp3
!voxer/sounds/boing.mp3
!voxer/sounds/hush.mp3
!voxer/sounds/ribbit.mp3
!voxer/sounds/doki-doki.mp3
!voxer/sounds/wan-wan.mp3
!voxer/sounds/noted.mp3
!voxer/sounds/bang.mp3
!voxer/sounds/beep.mp3
tasks/
